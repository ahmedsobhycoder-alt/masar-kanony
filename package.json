{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "type": "commonjs",
  "main": "dist/server.js",
  "exports": {
  ".": {
    "require": "./bundle.js",
    "import": "./bundle.js"
  },
  "./styled-components": {
    "require": "./build/utils/styled.js",
    "import": "./build/utils/styled.js",
    "types": "./types/src/utils/styled.d.ts"
  }
},
  "scripts": {
    "build": "tsc --project tsconfig.json && node scripts/copy-locales.cjs",
    "start": "node dist/server.js",
    "dev": "nodemon --exec tsx src/server.ts",
    "check": "npm run build",
    "seed:governorates": "tsx src/infrastructure/database/migrations/seeders/governoratesSeeder.ts -i",
    "destroy:governorates": "tsx src/infrastructure/database/migrations/seeders/governoratesSeeder.ts -d",
    "seed:floorNames": "tsx src/infrastructure/database/migrations/seeders/floorNamesSeeder.ts -i",
    "destroy:floorNames": "tsx src/infrastructure/database/migrations/seeders/floorNamesSeeder.ts -d",
    "seed:ads": "tsx src/infrastructure/database/migrations/seeders/adsSeeder.ts -i",
    "destroy:ads": "tsx src/infrastructure/database/migrations/seeders/adsSeeder.ts -d",
    "seed:courtTypes": "tsx src/infrastructure/database/migrations/seeders/courtTypesSeeder.ts -i",
    "destroy:courtTypes": "tsx src/infrastructure/database/migrations/seeders/courtTypesSeeder.ts -d",
    "seed:officeTypes": "tsx src/infrastructure/database/migrations/seeders/officeTypesSeeder.ts -i",
    "destroy:officeTypes": "tsx src/infrastructure/database/migrations/seeders/officeTypesSeeder.ts -d",
    "seed:courts": "tsx src/infrastructure/database/migrations/seeders/courtsSeeder.ts -i",
    "destroy:courts": "tsx src/infrastructure/database/migrations/seeders/courtsSeeder.ts -d",
    "seed:floors": "tsx src/infrastructure/database/migrations/seeders/floorsSeeder.ts -i",
    "destroy:floors": "tsx src/infrastructure/database/migrations/seeders/floorsSeeder.ts -d",
    "seed:offices": "tsx src/infrastructure/database/migrations/seeders/officesSeeder.ts -i",
    "destroy:offices": "tsx src/infrastructure/database/migrations/seeders/officesSeeder.ts -d",
    "seed:users": "tsx src/infrastructure/database/migrations/seeders/usersSeeder.ts -i",
    "destroy:users": "tsx src/infrastructure/database/migrations/seeders/usersSeeder.ts -d",
    "destroy:payments": "tsx src/infrastructure/database/migrations/seeders/paymentsSeeder.ts -d",
    "seed:appPolicy": "tsx src/infrastructure/database/migrations/seeders/appPolicySeeder.ts -i",
    "destroy:appPolicy": "tsx src/infrastructure/database/migrations/seeders/appPolicySeeder.ts -d",
    "admin:bundle": "adminjs bundle"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@adminjs/express": "^5.1.0",
    "@adminjs/mongoose": "^3.0.3",
    "adminjs": "^6.8.7",
    "bcrypt": "^6.0.0",
    "connect-mongo": "^6.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-async-handler": "^1.2.0",
    "express-formidable": "^1.2.0",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "i18next": "^26.4.2",
    "i18next-fs-backend": "^2.6.8",
    "i18next-http-middleware": "^3.9.9",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.6.0",
    "mongoose": "^9.10.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "sharp": "^0.35.4",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/body-parser": "^1.19.6",
    "@types/colors": "^1.1.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/i18next-fs-backend": "^1.1.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/sharp": "^0.31.1",
    "@types/uuid": "^10.0.0",
    "colors": "^1.4.0",
    "nodemon": "^3.1.14",
    "patch-package": "^8.0.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}

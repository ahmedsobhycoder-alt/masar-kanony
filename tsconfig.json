{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "paths": {
      "*": ["./*"],
      "styled-components": [
        "./node_modules/styled-components"
      ],
    },
  },
  "exclude": [
    "tests"
  ]
}